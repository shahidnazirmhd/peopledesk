APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Must match the credentials in the root .env used by docker-compose.yml
DATABASE_URL=postgresql+asyncpg://appuser:apppassword@localhost:5432/employee_db

# Generate a real secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In APP_ENV=production the app refuses to start with a weak/placeholder secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed browser origins (REST CORS and Socket.IO CORS)
CORS_ORIGINS=http://localhost:5173

# --- Optional tuning -------------------------------------------------------
# Login rate limiting: failed attempts allowed per window (per IP and per username)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Seed the default admin on startup when the users table is empty.
# (Can also be run manually: python -m app.database.init_db)
SEED_ADMIN_ON_STARTUP=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=Administrator
SEED_ADMIN_PASSWORD=Admin@123

# SQLAlchemy connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# bcrypt work factor (12 is a sensible default; tests use a lower value)
BCRYPT_ROUNDS=12

# Set to enable the Redis message queue so Socket.IO works across several
# backend processes/instances. Leave empty for a single process.
# SOCKETIO_REDIS_URL=redis://localhost:6379/0
