VITE_API_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:8000

# Optional. Socket.IO transports, comma separated, in order of preference:
#   polling,websocket   (default) start with HTTP long-polling, upgrade to WebSocket
#   polling             long-polling only (simulates a firewall that blocks WebSocket)
#   websocket           WebSocket only
# You can also switch at runtime without restarting: open the app with ?transports=polling
# (and ?transports=reset to go back to the default).
# VITE_SOCKET_TRANSPORTS=polling,websocket
